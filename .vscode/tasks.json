{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build workspace",
      "type": "cargo",
      "command": "build",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build dipsvg-rs",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "dipsvg-rs"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build palcore",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "palcore"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build palhal",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "palhal"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build palgui (csr)",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "palgui",
        "--features",
        "csr"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build palapp",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "palapp"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build palcli",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "palcli"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: build teefo-rs",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "teefo-rs"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: run palcli",
      "type": "cargo",
      "command": "run",
      "args": [
        "-p",
        "palcli",
        "--",
        "--help"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: test workspace",
      "type": "cargo",
      "command": "test",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test dipsvg-rs",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "dipsvg-rs"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test palcore",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "palcore"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test palhal",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "palhal"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test palgui (csr)",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "palgui",
        "--features",
        "csr"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test palapp",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "palapp"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test palcli",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "palcli"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: test teefo-rs",
      "type": "cargo",
      "command": "test",
      "args": [
        "-p",
        "teefo-rs"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "cargo: run palhal pinbench",
      "type": "cargo",
      "command": "run",
      "args": [
        "-p",
        "palhal",
        "--example",
        "pinbench",
        "--",
        "t48",
        "5"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "cargo: run palapp",
      "type": "shell",
      "command": "cargo tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/crates/palapp"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "trunk: serve palgui",
      "type": "shell",
      "command": "trunk serve --open",
      "options": {
        "cwd": "${workspaceFolder}/crates/palgui"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "trunk: build palgui",
      "type": "shell",
      "command": "trunk build",
      "options": {
        "cwd": "${workspaceFolder}/crates/palgui"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    }
  ]
}
